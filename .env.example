# To run the AI Tutor app (FastAPI backend)
# COHERE_API_KEY is always required (embeddings + rerank for retrieval).
COHERE_API_KEY=...
# Default chat path: DeepSeek V4 Flash via OpenRouter, with Gemini 3.5 Flash
# Lite as the local application fallback if OpenRouter fails.
OPENROUTER_API_KEY=...
GEMINI_API_KEY=...
# Gemini also accepts GOOGLE_API_KEY instead of GEMINI_API_KEY.
GOOGLE_API_KEY=...

# Optional alternate providers (DEEPSEEK_API_KEY is the retired first-party
# DeepSeek path, kept for experiments)
OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...
DEEPSEEK_API_KEY=...

# Optional: Slack-compatible incoming-webhook URL for ops alerts (provider
# outages and account-state errors like an unfunded or revoked key). Alerts
# are throttled to one per error class per hour; unset means log-only.
# AI_TUTOR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional deployment-wide memory-preset override. Normally leave this unset:
# the server selects prod_v2 for DeepSeek/Gemini and legacy prod for other
# providers. Direct API/eval requests can still override it with memoryPreset.
# AI_TUTOR_MEMORY_PRESET=prod

# Optional: trace agent/model/tool runs in LangSmith
LANGSMITH_API_KEY=...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-tutor-app
# Trace origin label (set HF Space variables to hf-dev or hf-prod; defaults to
# huggingface-space when SPACE_HOST exists, otherwise local)
# AI_TUTOR_DEPLOYMENT_ENV=local

# To update documentation/add new course
HF_TOKEN=... https://huggingface.co/settings/tokens to read or write to private DATASET repos e.g. https://huggingface.co/datasets/towardsai-tutors/ai-tutor-data/tree/main
GITHUB_TOKEN=...https://github.com/settings/tokens to use the Github API
